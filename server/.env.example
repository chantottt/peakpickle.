# Required for persistent Atlas mode. Never put credentials in source or chat.
MONGO_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@CLUSTER_HOST/peakpickle?retryWrites=true&w=majority
# Required: generate at least 32 random characters; no default in persistent mode.
JWT_SECRET=
# Optional; only port 5000 is supported.
PORT=5000
# Optional comma-separated allowed local frontend origins.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional sports scheduling timezone (default Asia/Manila).
BUSINESS_TIMEZONE=Asia/Manila
# Only used by create-admin; remove after account creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: verified existing sports ID for explicit member linking, not admin creation.
LINK_PLAYER_ID=
